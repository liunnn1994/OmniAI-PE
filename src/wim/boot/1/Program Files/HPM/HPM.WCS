//HPM支持
EXEC =!setx PATH "%ProgramFiles%\HPM\"

//创建桌面快捷方式
LINK %Desktop%\模块管理,%CurDir%\HPMMGR.exe

//创建开始菜单所有程序快捷方式
LINK %Programs%\HPM 模块\选择模块加载,%CurDir%\HPMLoad.WCS,,%CurDir%\HPMLoad.exe
LINK %Programs%\HPM 模块\选择模块加载(以普通模式),%CurDir%\HPMLoad_Default.WCS,,%CurDir%\HPMLoad.exe
LINK %Programs%\HPM 模块\清除默认模式,%CurDir%\HPMLoadClearDefaultMode.WCS,,%CurDir%\HPMLoad.exe
LINK %Programs%\HPM 模块\模块管理,%CurDir%\HPMMGR.exe,,


//以普通模式加载HPM包
FORX @\HotProgMods,HPMD,0,EXEC =!"%ProgramFiles%\HPM\HPMLoadCLI.exe" default %HPMD% /h
FORX @\HotPEModule,HPMD,0,EXEC =!"%ProgramFiles%\HPM\HPMLoadCLI.exe" default %HPMD% /h

//以快速模式加载HPM包
FORX @\HotProgModQ,HPMQ,0,EXEC =!"%ProgramFiles%\HPM\HPMLoadCLI.exe" quick %HPMQ% /h
FORX @\HotPEModuleQuick,HPMQ,0,EXEC =!"%ProgramFiles%\HPM\HPMLoadCLI.exe" quick %HPMQ% /h

ENVI @@DeskTopFresh=4